---
/**
 * 全局基础布局：包含 <head>、Header、Footer、暗色模式切换
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchBox from '../components/SearchBox.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noFooter?: boolean;
}

const {
  title,
  description = '面向数字 IC 后端（Physical Design / CTS / PV / Low Power）求职者的开源知识库',
  image = '/og-image.png',
  noFooter = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
// OG 协议要求绝对 URL
const imageURL = new URL(image, Astro.site ?? Astro.url.origin).href;
---

<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Backend KB Contributors" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Title -->
    <title>{title}</title>

    <!-- 主题检测 - 避免闪烁（默认浅色，仅手动切换过才用暗色） -->
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'light';
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>

    <!-- Pagefind 搜索样式（仅在文档页加载） -->
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />

    <!-- 网站统计占位 -->
    <!-- <script defer src="https://your-analytics.com/script.js"></script> -->
  </head>

  <body class="flex min-h-screen flex-col">
    <Header />

    <main class="flex-1">
      <slot />
    </main>

    {!noFooter && <Footer />}

    <SearchBox />
  </body>
</html>