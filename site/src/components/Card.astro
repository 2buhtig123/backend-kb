---
/**
 * 卡片组件 - 用于首页和列表页
 */
import Icon from './Icon.astro';

interface Props {
  href: string;
  icon: string;
  title: string;
  description?: string;
  badge?: string;
  badgeColor?: 'blue' | 'green' | 'amber' | 'purple';
}

const {
  href,
  icon,
  title,
  description = '',
  badge,
  badgeColor = 'blue',
} = Astro.props;

const badgeClass = {
  blue: 'badge-blue',
  green: 'badge-green',
  amber: 'badge-amber',
  purple: 'badge-purple',
}[badgeColor];
---

<a href={href} class="card group block">
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1">
      <div class="flex items-center gap-2">
        <Icon name={icon} class="h-5 w-5 text-slate-400 dark:text-slate-500" />
        <h3 class="text-lg font-semibold text-slate-900 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
          {title}
        </h3>
      </div>
      {description && (
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {description}
        </p>
      )}
    </div>
    {badge && <span class={badgeClass}>{badge}</span>}
  </div>
  <div class="mt-4 flex items-center text-sm text-blue-600 opacity-0 transition-opacity group-hover:opacity-100 dark:text-blue-400">
    阅读全文
    <svg class="ml-1 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
  </div>
</a>