---
/**
 * 左侧导航栏
 */
interface Props {
  module: string;
  moduleTitle: string;
  moduleIcon: string;
  moduleSlug: string;
  items: { title: string; slug: string }[];
  currentSlug: string;
}

const { moduleTitle, moduleIcon, moduleSlug, items, currentSlug } = Astro.props;

const MODULE_NAV = [
  { slug: 'basics', title: '基础知识', icon: '📚' },
  { slug: 'interview', title: '八股题库', icon: '📝' },
  { slug: 'autumn-recruit', title: '秋招汇总', icon: '🍂' },
  { slug: 'social-recruit', title: '社招汇总', icon: '💼' },
  { slug: 'internship', title: '实习汇总', icon: '🎯' },
  { slug: 'tools', title: '工具资源', icon: '🛠' },
];
---

<nav class="sticky top-20 max-h-[calc(100vh-5rem)] overflow-y-auto pr-2">
  <!-- 当前模块标题 -->
  <div class="mb-4 px-2">
    <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
      当前模块
    </h3>
    <a
      href={`/${moduleSlug}`}
      class="mt-1 flex items-center gap-1.5 text-sm font-semibold text-slate-900 hover:text-blue-600 dark:text-white dark:hover:text-blue-400"
    >
      <span>{moduleIcon}</span>
      <span>{moduleTitle}</span>
    </a>
  </div>

  <!-- 当前模块文章列表 -->
  <ul class="mb-6 space-y-0.5 border-l border-slate-200 dark:border-slate-800">
    {
      items.map((item) => {
        const isActive = currentSlug === `${moduleSlug}/${item.slug.replace(/^.*\//, '')}` ||
          currentSlug === item.slug;
        return (
          <li>
            <a
              href={`/docs/${item.slug}`}
              class:list={[
                '-ml-px block border-l py-1 pl-4 pr-2 text-sm transition-colors',
                isActive
                  ? 'border-blue-500 font-medium text-blue-600 dark:border-blue-400 dark:text-blue-400'
                  : 'border-transparent text-slate-600 hover:border-slate-300 hover:text-slate-900 dark:text-slate-400 dark:hover:border-slate-700 dark:hover:text-white',
              ]}
            >
              {item.title}
            </a>
          </li>
        );
      })
    }
  </ul>

  <!-- 模块切换 -->
  <div>
    <h3 class="mb-2 px-2 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
      切换模块
    </h3>
    <ul class="space-y-0.5">
      {
        MODULE_NAV.map((m) => (
          <li>
            <a
              href={`/${m.slug}`}
              class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
            >
              <span>{m.icon}</span>
              <span>{m.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>